{
  "name": "password-manager-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:packages": "npm --prefix ../packages/crypto run build && npm --prefix ../packages/password-generator run build",
    "predev": "npm run build:packages",
    "dev": "wxt",
    "prebuild": "npm run build:packages",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"*.{json,ts,js,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"*.{json,ts,js,md}\""
  },
  "dependencies": {
    "@password-manager/crypto": "file:../packages/crypto",
    "@password-manager/password-generator": "file:../packages/password-generator",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wxt": "^0.21.2"
  },
  "engines": {
    "node": ">=22"
  }
}
