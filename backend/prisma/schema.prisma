generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique @db.VarChar(320)
  passwordHash      String             @map("password_hash")
  encryptionProfile EncryptionProfile?
  refreshTokens     RefreshToken[]
  vaults            Vault[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.Char(64)
  familyId            String    @map("family_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash") @db.Char(64)
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EncryptionProfile {
  userId          String   @id @map("user_id") @db.Uuid
  version         Int
  kdfAlgorithm    String   @map("kdf_algorithm") @db.VarChar(20)
  kdfSalt         String   @map("kdf_salt") @db.VarChar(22)
  kdfMemoryKiB    Int      @map("kdf_memory_kib")
  kdfIterations   Int      @map("kdf_iterations")
  kdfParallelism  Int      @map("kdf_parallelism")
  wrappedVaultKey String   @map("wrapped_vault_key") @db.VarChar(128)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("encryption_profiles")
}

model Vault {
  id            String   @id @db.Uuid
  encryptedData String   @map("encrypted_data")
  ownerId       String   @map("owner_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folders       Folder[]
  entries       Entry[]

  @@index([ownerId])
  @@map("vaults")
}

model Folder {
  id            String   @id @db.Uuid
  encryptedData String   @map("encrypted_data")
  vaultId       String   @map("vault_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  vault         Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  entries       Entry[]

  @@index([vaultId])
  @@map("folders")
}

model Entry {
  id            String   @id @db.Uuid
  encryptedData String   @map("encrypted_data")
  vaultId       String   @map("vault_id") @db.Uuid
  folderId      String?  @map("folder_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  vault         Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  folder        Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([vaultId])
  @@index([folderId])
  @@map("entries")
}
